---
interface Props { title: string; description: string; jsonld?: object[]; type?: 'website' | 'article' | 'profile'; mdTwin?: string }
const { title, description, jsonld = [], type = 'website', mdTwin } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);
const path = Astro.url.pathname;
const nav = [['/work/', 'Work'], ['/projects/', 'Projects'], ['/about/', 'About']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ashutosh Dey" />
    <link rel="canonical" href={canonical} />
    {mdTwin && <link rel="alternate" type="text/markdown" href={mdTwin} />}
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="me" href="https://github.com/ashutoshdey21" />
    <link rel="me" href="https://www.linkedin.com/in/ashutoshdey" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content="Ashutosh Dey" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ashutosh Dey, backend engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="color-scheme" content="light dark" />
    {jsonld.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <slot name="head" />
    <style is:global>
      :root { --bg:#fbfaf8; --fg:#1b1b1b; --muted:#5d5d5d; --line:#e3e0da; --link:#0b57a4; --accent:#0b57a4; --card:#fff; }
      @media (prefers-color-scheme: dark) { :root { --bg:#111214; --fg:#ebebeb; --muted:#a3a3a3; --line:#2b2d31; --link:#86b8ff; --accent:#86b8ff; --card:#18191c; } }
      *, *::before, *::after { box-sizing:border-box; }
      body { margin:0; background:var(--bg); color:var(--fg); font:17px/1.65 ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif; -webkit-text-size-adjust:100%; }
      header.site, main, footer.site { max-width:44rem; margin:0 auto; padding:0 1rem; }
      header.site { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:.5rem 1.5rem; padding-top:1.5rem; padding-bottom:1rem; border-bottom:1px solid var(--line); }
      header.site .name { font-weight:700; color:var(--fg); text-decoration:none; }
      header.site nav { display:flex; gap:1.1rem; }
      header.site nav a { color:var(--muted); text-decoration:none; }
      header.site nav a[aria-current="page"], header.site nav a:hover { color:var(--fg); }
      main { padding-top:2rem; padding-bottom:3rem; }
      footer.site { padding-top:1.5rem; padding-bottom:2.5rem; border-top:1px solid var(--line); color:var(--muted); font-size:.85rem; }
      footer.site a { color:var(--muted); }
      a { color:var(--link); text-underline-offset:.15em; }
      h1 { font-size:2rem; line-height:1.2; letter-spacing:-.01em; margin:.5rem 0 1rem; }
      h2 { font-size:1.35rem; line-height:1.3; margin:2.2rem 0 .6rem; }
      h3 { font-size:1.1rem; margin:1.6rem 0 .4rem; }
      code { font-size:.88em; overflow-wrap:anywhere; }
      pre { overflow-x:auto; padding:1rem; background:var(--card); border:1px solid var(--line); border-radius:6px; font-size:.78rem; line-height:1.45; }
      pre code { overflow-wrap:normal; }
      .muted { color:var(--muted); }
      .crumbs { font-size:.9rem; color:var(--muted); margin:0; }
      .crumbs a { color:var(--muted); }
    </style>
  </head>
  <body>
    <header class="site">
      <a class="name" href="/">Ashutosh Dey</a>
      <nav aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site">
      <p>
        Ashutosh Dey · Backend engineer · San Francisco / Redwood City, CA ·
        <a href="https://github.com/ashutoshdey21" rel="me">GitHub</a> ·
        <a href="https://www.linkedin.com/in/ashutoshdey" rel="me">LinkedIn</a>
      </p>
      <p>
        Prose and case studies: <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>. Code samples: MIT.
        · <a href="/llms.txt">llms.txt</a> · <a href="/facts.json">facts.json</a>
      </p>
    </footer>
  </body>
</html>
