---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { LENSES } from '../../content.config';
export async function getStaticPaths() {
  return (await getCollection('work')).map((w) => ({ params: { slug: w.id }, props: { w } }));
}
const { w } = Astro.props;
const { Content } = await render(w);
const url = new URL(`/work/${w.id}/`, Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: w.data.title,
  description: w.data.summary,
  author: { '@type': 'Person', name: 'Ashutosh Dey', url: 'https://ashutoshdey21.github.io/' },
  keywords: [...w.data.themes.map((t) => LENSES[t]), ...w.data.stack].join(', '),
  license: 'https://creativecommons.org/licenses/by/4.0/',
  url,
  mainEntityOfPage: url,
};
---
<Base title={`${w.data.title} | Ashutosh Dey`} description={w.data.summary}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <p><a href="/">Ashutosh Dey</a> / <a href="/work/">Work</a></p>
  <article>
    <h1>{w.data.title}</h1>
    <p class="muted">{w.data.context}{w.data.stack.length > 0 && <> · {w.data.stack.join(', ')}</>}</p>
    <p><strong>{w.data.summary}</strong></p>
    <Content />
  </article>
</Base>
<style is:global>
  article pre { overflow-x:auto; padding:1rem; border:1px solid var(--muted); border-radius:6px; font-size:.8rem; line-height:1.4; }
</style>
