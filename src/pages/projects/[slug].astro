---
import Base from '../../layouts/Base.astro';
import EntryPage from '../../components/EntryPage.astro';
import { getCollection, render } from 'astro:content';
import { authorRef } from '../../lib/data';
export async function getStaticPaths() {
  return (await getCollection('projects')).map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content } = await render(p);
const ld = {
  '@context': 'https://schema.org',
  '@type': p.data.repo ? 'SoftwareSourceCode' : 'CreativeWork',
  name: p.data.title,
  description: p.data.summary,
  author: authorRef,
  ...(p.data.repo && { codeRepository: p.data.repo }),
  ...(p.data.language && { programmingLanguage: p.data.language }),
  url: new URL(`/projects/${p.id}/`, Astro.site).href,
};
---
<Base title={`${p.data.title} | Ashutosh Dey`} description={p.data.summary} type="article" mdTwin={`/projects/${p.id}.md`}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <EntryPage data={p.data} section={{ href: '/projects/', label: 'All projects' }} links={p.data.links} readLabel="Read the full design">
    <Content />
  </EntryPage>
</Base>
