---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { allContent } from '../../lib/data';
const { projects } = await allContent();
---
<Base title="Projects | Ashutosh Dey" description="Projects by Ashutosh Dey, software engineer: neurostore and a multi-agent ticket-to-PR workflow.">
  <h1>Projects</h1>
  <p class="muted intro">Open-source code and the tools I build for how I work.</p>
  <div class="grid">
    {projects.map((p) => <Card href={`/projects/${p.id}/`} data={p.data} />)}
  </div>
</Base>
<style>.intro { margin:-.4rem 0 1.75rem; font-size:1.05rem; }</style>
