---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { positioning, profile, allContent, personLd, SITE } from '../lib/data';
const { work, projects } = await allContent();
const featured = positioning.featured.map((id: string) => work.find((w) => w.id === id)).filter(Boolean);
const h = positioning.hero;
const ld = [
  personLd(),
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Ashutosh Dey', url: `${SITE}/`, author: { '@id': `${SITE}/#person` } },
];
---
<Base title="Ashutosh Dey · Software engineer" description={`${positioning.descriptor}. ${positioning.headline}`} jsonld={ld} type="profile" mdTwin="/index.md">
  <section class="hero">
    <p class="kicker">{h.kicker}</p>
    <h1>{h.lead} <em>{h.em}</em> {h.tail}</h1>
    <p class="meta">{h.meta}</p>
    <p class="cta">
      <a class="btn" href="/work/">See my work</a>
      <a class="btn ghost" href={profile.links.linkedin} rel="me">LinkedIn</a>
      <a class="btn ghost" href={profile.links.github} rel="me">GitHub</a>
    </p>
  </section>

  <section aria-label="Selected results">
    <ul class="results">
      {positioning.results.map((r: any) => {
        const inner = <><span class="v">{r.value}</span><span class="l">{r.label}</span><span class="s">{r.sub}</span></>;
        return <li>{r.href ? <a href={r.href}>{inner}</a> : <div>{inner}</div>}</li>;
      })}
    </ul>
  </section>

  <section aria-labelledby="featured">
    <div class="section-head">
      <h2 id="featured">Featured work</h2>
      <a href="/work/">All case studies →</a>
    </div>
    <div class="grid">
      {featured.map((w: any) => <Card href={`/work/${w.id}/`} data={w.data} />)}
    </div>
  </section>

  <section aria-labelledby="beyond">
    <div class="section-head">
      <h2 id="beyond">Also building</h2>
      <a href="/projects/">All projects →</a>
    </div>
    <div class="grid two">
      {projects.map((p) => <Card href={`/projects/${p.id}/`} data={p.data} />)}
    </div>
  </section>
</Base>
<style>
  .hero { padding:2.5rem 0 1rem; max-width:52rem; }
  .kicker { margin:0 0 .9rem; font-weight:600; color:var(--accent); font-size:1rem; }
  .hero h1 { font-size:clamp(2rem, 6vw, 3.3rem); line-height:1.08; letter-spacing:-.035em; font-weight:780; margin:0 0 1.1rem; text-wrap:balance; }
  .hero em { font-style:normal; background:linear-gradient(100deg, var(--accent), #b44cd8); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .meta { color:var(--muted); margin:0 0 1.6rem; font-size:1rem; }
  .cta { display:flex; flex-wrap:wrap; gap:.65rem; margin:0; }
  .results { list-style:none; margin:2.75rem 0 0; padding:0; display:grid; grid-template-columns:repeat(auto-fit, minmax(13rem, 1fr)); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:var(--radius); overflow:hidden; }
  .results li { background:var(--card); }
  .results a, .results div { display:flex; flex-direction:column; gap:.2rem; padding:1.2rem 1.25rem; height:100%; color:inherit; text-decoration:none; }
  .results a:hover { background:var(--accent-soft); }
  .v { font-size:clamp(1.9rem, 5vw, 2.4rem); font-weight:780; letter-spacing:-.03em; line-height:1.05; color:var(--accent); font-variant-numeric:tabular-nums; }
  .l { font-weight:600; font-size:.95rem; line-height:1.35; }
  .s { font-size:.8rem; color:var(--muted); line-height:1.4; }
  @media (max-width:640px) { .results { grid-template-columns:1fr 1fr; } .results a, .results div { padding:1rem; } .s { display:none; } }
  .grid.two { grid-template-columns:repeat(auto-fill, minmax(17.5rem, 1fr)); }
</style>
