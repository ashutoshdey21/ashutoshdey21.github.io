---
import { LENSES } from '../content.config';
interface Props { href: string; data: any; showStat?: boolean }
const { href, data, showStat = true } = Astro.props;
const lens = LENSES[data.themes[0] as keyof typeof LENSES];
const stat = showStat ? data.stats?.[0] : undefined;
---
<article class="card">
  <p class="eyebrow">{lens}{data.status && <span class="badge">{data.status}</span>}</p>
  <h3><a href={href}>{data.short ?? data.title}</a></h3>
  <p class="hook">{data.hook}</p>
  {stat && <p class="stat"><strong>{stat.value}</strong> {stat.label}</p>}
  <p class="more" aria-hidden="true">Read →</p>
</article>
<style>
  .card { position:relative; display:flex; flex-direction:column; gap:.45rem; padding:1.25rem 1.25rem 1.1rem; background:var(--card); border:1px solid var(--line); border-radius:var(--radius); transition:border-color .15s, transform .15s, box-shadow .15s; }
  .card:hover { border-color:var(--accent); transform:translateY(-2px); box-shadow:0 8px 24px -12px var(--shadow); }
  .card:focus-within { border-color:var(--accent); }
  .eyebrow { margin:0; font-size:.72rem; font-weight:600; text-transform:uppercase; letter-spacing:.08em; color:var(--muted); display:flex; flex-wrap:wrap; gap:.5rem; align-items:center; }
  .badge { text-transform:none; letter-spacing:0; font-weight:600; font-size:.72rem; padding:.05rem .5rem; border-radius:999px; background:var(--warn-bg); color:var(--warn-fg); }
  h3 { margin:0; font-size:1.12rem; line-height:1.3; }
  h3 a { color:var(--fg); text-decoration:none; }
  h3 a::after { content:''; position:absolute; inset:0; border-radius:var(--radius); }
  .hook { margin:0; color:var(--muted); font-size:.95rem; line-height:1.5; }
  .stat { margin:.35rem 0 0; font-size:.88rem; }
  .stat strong { color:var(--accent); font-size:1.05rem; }
  .more { margin:auto 0 0; padding-top:.4rem; font-size:.88rem; font-weight:600; color:var(--accent); }
</style>
