---
import Card from './Card.astro';
import { LENSES } from '../content.config';
interface Props { items: any[]; active?: string }
const { items, active } = Astro.props;
---
<nav aria-label="Filter by lens" class="chips">
  <a href="/work/" aria-current={!active ? 'page' : undefined}>All</a>
  {Object.entries(LENSES).map(([slug, label]) => (
    <a href={`/work/lens/${slug}/`} aria-current={active === slug ? 'page' : undefined}>{label}</a>
  ))}
</nav>
<div class="grid">
  {items.map((w) => <Card href={`/work/${w.id}/`} data={w.data} />)}
</div>
<style>
  .chips { display:flex; flex-wrap:wrap; gap:.45rem; margin:0 0 1.5rem; }
  .chips a { font-size:.85rem; font-weight:500; padding:.32rem .8rem; border:1px solid var(--line); border-radius:999px; text-decoration:none; color:var(--muted); background:var(--card); }
  .chips a:hover { color:var(--fg); border-color:var(--fg); }
  .chips a[aria-current="page"] { background:var(--fg); border-color:var(--fg); color:var(--bg); }
</style>
